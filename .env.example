# ------------------------------
# PrintCraft API Environment
# ------------------------------

# Development (local)
JwtSecret=replace-with-very-strong-dev-secret-min-32-chars
JwtIssuer=printcraft-api
JwtAudience=printcraft-client

# Email provider
# Use only Email__ApiToken for consistency. MAILTRAP_API_TOKEN is not used.
Email__ApiToken=replace-me
Email__Username=replace-me
Email__Password=replace-me

# Production note:
# In production, set the SAME variable names (JwtSecret/JwtIssuer/JwtAudience)
# through your hosting environment secret manager (not a committed file).